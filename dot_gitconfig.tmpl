[user]
	email = {{ .email | quote}}
	name = {{ .name}}
	signingkey = {{ .email}}
[commit]
	gpgsign = true
{{- if and (lookPath "pass") (stat (joinPath .chezmoi.homeDir ".password-store")) }}
[github]
	signingkey = {{ .email}}
	token = {{ pass "github/full-access/api-key" }}
{{- end }}
[core]
	pager = delta
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = gruvbox-dark
[interactive]
	diffFilter = delta --color-only
