#!/bin/bash
set -euo pipefail

# 提前配置 gpg-agent 长缓存并重载，避免安装耗时导致后续解密二次弹窗
mkdir -p "$HOME/.gnupg" && chmod 700 "$HOME/.gnupg"
cat << 'GPGEOF' > "$HOME/.gnupg/gpg-agent.conf"
max-cache-ttl 60480000
default-cache-ttl 60480000
max-cache-ttl-ssh 60480000
default-cache-ttl-ssh 60480000
GPGEOF
gpgconf --kill gpg-agent 2>/dev/null || true

echo "==> [10-packages] 安装系统包..."

{{ if .isMac -}}
if ! command -v brew &>/dev/null; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    [ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"
    [ -x /usr/local/bin/brew ] && eval "$(/usr/local/bin/brew shellenv)"
fi
brew install \
    git curl wget unzip zsh tmux neovim powerlevel10k \
    node go python pyenv fzf zoxide direnv atuin fasd \
    ripgrep fd bat eza htop jq pass gnupg gh

{{ else if .isArch -}}
if [ "$EUID" -eq 0 ]; then
    echo "ERROR: 请勿直接以 root 用户运行！" >&2
    exit 1
fi

# zoxide 与 atuin 均在 Arch 官方仓库中，无需编译 yay
sudo pacman -Syu --noconfirm --needed \
    git curl wget unzip zip tar base-devel openssh \
    zsh tmux neovim \
    nodejs npm go python python-pip \
    fzf zoxide atuin direnv \
    ripgrep fd bat eza \
    htop jq pass gnupg github-cli

# fasd 直接源码安装（纯 Shell 脚本，1 秒完成）
if ! command -v fasd &>/dev/null; then
    rm -rf /tmp/fasd
    git clone --depth=1 https://github.com/clvv/fasd.git /tmp/fasd
    sudo make -C /tmp/fasd install
    rm -rf /tmp/fasd
fi

# Powerlevel10k 主题直接克隆
if [ ! -f /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme ] && [ ! -d "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k" ]; then
    git clone --depth=1 https://github.com/romkatv/powerlevel10k.git "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k"
fi

{{ else if .isUbuntu -}}
sudo apt-get update -qq
sudo apt-get install -y \
    git curl wget openssh-client locales zsh tmux \
    nodejs npm golang-go python3 python3-pip python3-venv \
    fzf direnv ripgrep fd-find bat htop jq pass gnupg \
    make build-essential unzip zip software-properties-common apt-transport-https ca-certificates

if ! command -v fd &>/dev/null && command -v fdfind &>/dev/null; then
    mkdir -p "$HOME/.local/bin" && ln -sf "$(which fdfind)" "$HOME/.local/bin/fd"
fi
if ! command -v bat &>/dev/null && command -v batcat &>/dev/null; then
    mkdir -p "$HOME/.local/bin" && ln -sf "$(which batcat)" "$HOME/.local/bin/bat"
fi
if ! command -v nvim &>/dev/null; then
    sudo add-apt-repository -y ppa:neovim-ppa/unstable && sudo apt-get update -qq && sudo apt-get install -y neovim
fi
if ! command -v gh &>/dev/null; then
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | sudo dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null
    sudo apt-get update -qq && sudo apt-get install -y gh
fi
if ! command -v eza &>/dev/null; then
    sudo mkdir -p /etc/apt/keyrings
    wget -qO- https://raw.githubusercontent.com/eza-community/eza/main/deb.asc | sudo gpg --dearmor -o /etc/apt/keyrings/gierens.gpg
    echo "deb [signed-by=/etc/apt/keyrings/gierens.gpg] http://deb.gierens.de stable main" | sudo tee /etc/apt/sources.list.d/gierens.list
    sudo apt-get update -qq && sudo apt-get install -y eza
fi
if ! command -v zoxide &>/dev/null; then
    curl -sSfL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | bash
fi
if ! command -v atuin &>/dev/null; then
    curl --proto '=https' --tlsv1.2 -LsSf https://setup.atuin.sh | bash
fi
if ! command -v fasd &>/dev/null; then
    rm -rf /tmp/fasd && git clone --depth=1 https://github.com/clvv/fasd.git /tmp/fasd && sudo make -C /tmp/fasd install && rm -rf /tmp/fasd
fi
if [ ! -f /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme ] && [ ! -d "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k" ]; then
    git clone --depth=1 https://github.com/romkatv/powerlevel10k.git "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k"
fi

{{ else if .isDebian -}}
sudo apt-get update -qq
sudo apt-get install -y \
    git curl wget openssh-client locales zsh tmux neovim \
    nodejs npm golang-go python3 python3-pip python3-venv \
    fzf direnv ripgrep fd-find bat htop jq pass gnupg \
    make build-essential unzip zip apt-transport-https ca-certificates

if ! command -v fd &>/dev/null && command -v fdfind &>/dev/null; then
    mkdir -p "$HOME/.local/bin" && ln -sf "$(which fdfind)" "$HOME/.local/bin/fd"
fi
if ! command -v bat &>/dev/null && command -v batcat &>/dev/null; then
    mkdir -p "$HOME/.local/bin" && ln -sf "$(which batcat)" "$HOME/.local/bin/bat"
fi
if ! command -v gh &>/dev/null; then
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | sudo dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null
    sudo apt-get update -qq && sudo apt-get install -y gh
fi
if ! command -v eza &>/dev/null; then
    sudo mkdir -p /etc/apt/keyrings
    wget -qO- https://raw.githubusercontent.com/eza-community/eza/main/deb.asc | sudo gpg --dearmor -o /etc/apt/keyrings/gierens.gpg
    echo "deb [signed-by=/etc/apt/keyrings/gierens.gpg] http://deb.gierens.de stable main" | sudo tee /etc/apt/sources.list.d/gierens.list
    sudo apt-get update -qq && sudo apt-get install -y eza
fi
if ! command -v zoxide &>/dev/null; then
    curl -sSfL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh | bash
fi
if ! command -v atuin &>/dev/null; then
    curl --proto '=https' --tlsv1.2 -LsSf https://setup.atuin.sh | bash
fi
if ! command -v fasd &>/dev/null; then
    rm -rf /tmp/fasd && git clone --depth=1 https://github.com/clvv/fasd.git /tmp/fasd && sudo make -C /tmp/fasd install && rm -rf /tmp/fasd
fi
if [ ! -f /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme ] && [ ! -d "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k" ]; then
    git clone --depth=1 https://github.com/romkatv/powerlevel10k.git "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k"
fi

{{ else -}}
echo "ERROR: 不支持的操作系统" >&2
exit 1
{{ end -}}

{{ if not .isMac -}}
if [ -f /etc/locale.gen ] && ! locale -a 2>/dev/null | grep -qi "en_US.utf8"; then
    sudo sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
    sudo locale-gen
fi
{{ end -}}

echo "==> [10-packages] 完成 ✓"
